<!--
  自定义行为树: 适用于 RTK Spline Planner + Pure Pursuit Demo
  - 以 1Hz 频率重规划全局路径
  - FollowPath 持续跟踪最新路径
-->

<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <PipelineSequence name="NavigateWithReplanning">
      <RateController hz="1.0">
        <ComputePathToPose goal="{goal}" path="{path}" planner_id="RtkSplinePlanner"/>
      </RateController>
      <FollowPath path="{path}" controller_id="FollowPath"/>
    </PipelineSequence>
  </BehaviorTree>
</root>
