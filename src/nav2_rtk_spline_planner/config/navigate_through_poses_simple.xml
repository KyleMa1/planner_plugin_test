<!--
  NavigateThroughPoses 最小行为树（无 recovery 依赖）
  仅用于满足 bt_navigator 加载要求，实际 Demo 使用 NavigateToPose
-->

<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <PipelineSequence name="NavigateWithReplanning">
      <RateController hz="1.0">
        <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="RtkSplinePlanner"/>
      </RateController>
      <FollowPath path="{path}" controller_id="FollowPath"/>
    </PipelineSequence>
  </BehaviorTree>
</root>
